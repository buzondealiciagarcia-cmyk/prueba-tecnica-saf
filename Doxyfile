# Doxyfile mínimo (STD-DOC §5). Uso: doxygen Doxyfile
PROJECT_NAME           = "prueba-saf"
OUTPUT_DIRECTORY       = build/doxygen
INPUT                  = include src
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.c
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
GENERATE_LATEX         = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO
ALIASES                = "req=@par Requisitos:^^" "contract=@par Contrato:^^"
HTML_COLORSTYLE        = LIGHT
HTML_COLORSTYLE_HUE    = 213
HTML_COLORSTYLE_SAT    = 120
HTML_COLORSTYLE_GAMMA  = 90
