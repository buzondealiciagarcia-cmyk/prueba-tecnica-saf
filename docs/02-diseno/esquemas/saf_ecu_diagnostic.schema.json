{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saf_ecu_diagnostic.schema.json",
  "title": "Payload de saf/ecu/diagnostic",
  "description": "Diagnóstico periódico de la ECU. Requisitos: SYS-OUT-07, SYS-IN-07. Tabla 5.2 de diseno.md.",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "description": "Versión del esquema del payload (MQ-PAY-02)"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Número de secuencia (MQ-PAY-02, MQ-QOS-02)"
    },
    "ts_ms": {
      "type": "integer",
      "description": "Marca de tiempo en ms (MQ-PAY-02, MQ-PAY-04)"
    },
    "src": {
      "type": "string",
      "description": "Origen del mensaje (MQ-PAY-02)"
    },
    "seq_gap_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Contador de huecos por seq (MQ-QOS-02)"
    },
    "seq_disorder_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Contador de desorden por seq (MQ-QOS-02)"
    },
    "inputs_state": {
      "type": "object",
      "description": "Estado de entradas; su contenido se concreta en implementación"
    }
  },
  "required": [
    "v",
    "seq",
    "ts_ms",
    "src",
    "seq_gap_count",
    "seq_disorder_count",
    "inputs_state"
  ],
  "additionalProperties": false
}
