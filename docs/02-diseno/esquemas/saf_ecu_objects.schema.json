{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saf_ecu_objects.schema.json",
  "title": "Payload de saf/ecu/objects",
  "description": "Lista de objetos para trazabilidad (opcional, QoS 0). Requisitos: SYS-OUT-11, SYS-IMP-04. Tabla 5.2 de diseno.md.",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "description": "Versión del esquema del payload (MQ-PAY-02)"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Número de secuencia (MQ-PAY-02, MQ-QOS-02)"
    },
    "ts_ms": {
      "type": "integer",
      "description": "Marca de tiempo en ms (MQ-PAY-02, MQ-PAY-04)"
    },
    "src": {
      "type": "string",
      "description": "Origen del mensaje (MQ-PAY-02)"
    },
    "objects": {
      "type": "array",
      "description": "Lista de objetos",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "description": "Identificador del objeto (SYS-OUT-10)"
          },
          "position_s_m": {
            "type": "number",
            "description": "Coordenada s de vía en m"
          },
          "position_d_m": {
            "type": "number",
            "description": "Coordenada d de vía en m"
          },
          "size_m": {
            "type": "number",
            "description": "Tamaño del objeto en m"
          },
          "uncertainty_m": {
            "type": "number",
            "minimum": 0,
            "description": "Incertidumbre en m"
          },
          "confidence": {
            "type": "number",
            "description": "Confianza del objeto"
          }
        },
        "required": [
          "id",
          "position_s_m",
          "position_d_m",
          "size_m",
          "uncertainty_m",
          "confidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "v",
    "seq",
    "ts_ms",
    "src",
    "objects"
  ],
  "additionalProperties": false
}
