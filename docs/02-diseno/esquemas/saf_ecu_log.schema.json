{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saf_ecu_log.schema.json",
  "title": "Payload de saf/ecu/log",
  "description": "Log de la ECU, publicado por evento. Requisitos: SYS-OUT-09, SYS-IMP-04. Tabla 5.2 de diseno.md.",
  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "description": "Versión del esquema del payload (MQ-PAY-02)"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Número de secuencia (MQ-PAY-02, MQ-QOS-02)"
    },
    "ts_ms": {
      "type": "integer",
      "description": "Marca de tiempo en ms (MQ-PAY-02, MQ-PAY-04)"
    },
    "src": {
      "type": "string",
      "description": "Origen del mensaje (MQ-PAY-02)"
    },
    "level": {
      "type": "string",
      "description": "Nivel del log"
    },
    "msg": {
      "type": "string",
      "description": "Texto del log"
    }
  },
  "required": [
    "v",
    "seq",
    "ts_ms",
    "src",
    "level",
    "msg"
  ],
  "additionalProperties": false
}
